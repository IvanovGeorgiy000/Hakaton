          "const": "frame-analysis-input-v1"
        },
        "result_version": {
          "const": "frame-analysis-result-v1"
        },
        "catalog_version": {
          "$ref": "#/$defs/id"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "required": [
        "schema_version",
        "service",
        "service_version",
        "input_version",
        "result_version",
        "catalog_version",
        "limits"
      ],
      "additionalProperties": false
