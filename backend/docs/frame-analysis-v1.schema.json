          "const": 500
        },
        "progress_events_max": {
          "const": 1000
        },
        "model_context_max_chars": {
          "type": "integer",
          "minimum": 1
        },
        "idempotency_retention_seconds": {
          "type": "integer",
          "minimum": 604800
        }
      },
      "required": [
        "image_max_bytes",
        "metadata_max_bytes",
        "image_max_side",
        "image_max_pixels",
        "detections_max",
        "plan_steps_max",
        "history_observations_max",
        "progress_events_max",
        "model_context_max_chars",
