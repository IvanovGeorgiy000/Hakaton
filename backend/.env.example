# Скопируйте в .env и поменяйте нужное. Все значения ниже — значения по умолчанию.

# --- база ---
# SK_DATABASE_URL=sqlite+aiosqlite:///./data/stroykontrol.db
# SK_DATABASE_URL=postgresql+asyncpg://stroykontrol:stroykontrol@localhost:5432/stroykontrol   # нужен extra: uv sync --extra postgres

# --- доступ ---
SK_SECRET_KEY=dev-only-secret-change-me     # ОБЯЗАТЕЛЬНО поменяйте вне стенда: подпись токенов, шифрование паролей камер, учётка шлюза
SK_DEMO_MODE=true                            # вход по роли без пароля, страница /demo, демо-ролики в форме камеры
SK_DEMO_PASSWORD=demo                        # пароль учётных записей стенда (применяется при первом наполнении базы)
SK_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# --- Keycloak (единый вход через OpenID Connect); задайте issuer, чтобы включить ---
# SK_KEYCLOAK_ISSUER=http://localhost:8080/realms/stroykontrol
# SK_KEYCLOAK_CLIENT_ID=stroykontrol-web
# SK_KEYCLOAK_AUTO_PROVISION=true   # пускать пользователя Keycloak, которого нет в базе (без привязки к объектам)
# служебный клиент: через него админка меняет в Keycloak сотрудников, роли и пароли (для разработки — из infra/keycloak)
# SK_KEYCLOAK_ADMIN_CLIENT_ID=stroykontrol-backend
# SK_KEYCLOAK_ADMIN_CLIENT_SECRET=stroykontrol-dev-backend-secret

# --- видео (шлюз mediamtx: RTSP с камер → WebRTC в браузер; см. infra/mediamtx) ---
SK_VIDEO_ENABLED=true
SK_VIDEO_API_URL=http://127.0.0.1:9997       # API шлюза: сервер сам заводит в нём потоки камер
SK_VIDEO_RTSP_URL=rtsp://127.0.0.1:8554      # отсюда сервер берёт кадры на анализ и сюда публикует демо-ролики
SK_VIDEO_WEBRTC_URL=http://localhost:8889    # этот адрес получает браузер
SK_CAMERA_TIMEOUT_S=6
SK_ALLOW_LOOPBACK_CAMERAS=true               # разрешить 127.0.0.1 — демо-ролики крутит шлюз на этом же компьютере

# --- анализ кадров ---
SK_FRAME_INTERVAL_S=2                        # раз во сколько секунд кадр с каждой камеры уходит на анализ
SK_CHECK_INTERVAL_S=60                       # раз во сколько секунд объект сверяется с планом; 0 — не сверять в фоне
SK_ANALYSIS_PROVIDER=mock                    # mock — демо-анализатор; http — внешний сервис; push — сервис сам шлёт детекции
# SK_ANALYSIS_API_URL=http://localhost:8200/analyze
# SK_ANALYSIS_API_KEY=
# SK_INGEST_API_KEY=                         # включает приём готовых детекций: POST /api/ingest/snapshots

# --- рамки техники в реальном времени (сервис разметки: детектор + трекер) ---
# SK_TRACKER_URL=ws://127.0.0.1:8200/stream   # WebSocket сервиса; не задан — рамки из анализа раз в 2 с
# SK_TRACKER_API_KEY=dev-tracker-key          # ключ сервиса: список камер, чтение видео из шлюза (логин sk-tracker)
# SK_TRACKER_VIDEO_DELAY_MS=150               # на сколько придержать видео, чтобы рамки попадали в технику
