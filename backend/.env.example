# Скопируйте в .env и поменяйте нужное. Все значения ниже — значения по умолчанию.

# --- база ---
# SK_DATABASE_URL=sqlite+aiosqlite:///./data/stroykontrol.db
# SK_DATABASE_URL=postgresql+asyncpg://stroykontrol:stroykontrol@localhost:5432/stroykontrol   # нужен extra: uv sync --extra postgres

# --- доступ ---
SK_SECRET_KEY=dev-only-secret-change-me     # ОБЯЗАТЕЛЬНО поменяйте вне стенда: подпись токенов, шифрование паролей камер, учётка шлюза
SK_DEMO_MODE=true                            # вход по роли без пароля, страница /demo, демо-ролики в форме камеры
SK_DEMO_PASSWORD=demo                        # пароль учётных записей стенда (применяется при первом наполнении базы)
SK_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# --- Keycloak (единый вход через OpenID Connect); задайте issuer, чтобы включить ---
# SK_KEYCLOAK_ISSUER=http://localhost:8080/realms/stroykontrol
# SK_KEYCLOAK_CLIENT_ID=stroykontrol-web
# SK_KEYCLOAK_AUTO_PROVISION=true   # пускать пользователя Keycloak, которого нет в базе (без привязки к объектам)
# служебный клиент: через него админка меняет в Keycloak сотрудников, роли и пароли (для разработки — из infra/keycloak)
# SK_KEYCLOAK_ADMIN_CLIENT_ID=stroykontrol-backend
# SK_KEYCLOAK_ADMIN_CLIENT_SECRET=stroykontrol-dev-backend-secret

# --- видео (шлюз mediamtx: RTSP с камер → WebRTC в браузер; см. infra/mediamtx) ---
SK_VIDEO_ENABLED=true
SK_VIDEO_API_URL=http://127.0.0.1:9997       # API шлюза: сервер сам заводит в нём потоки камер
SK_VIDEO_RTSP_URL=rtsp://127.0.0.1:8554      # отсюда сервер берёт кадры на анализ и сюда публикует демо-ролики
SK_VIDEO_WEBRTC_URL=http://localhost:8889    # этот адрес получает браузер
SK_CAMERA_TIMEOUT_S=6
SK_ALLOW_LOOPBACK_CAMERAS=true               # разрешить 127.0.0.1 — демо-ролики крутит шлюз на этом же компьютере

# --- анализ кадров ---
SK_FRAME_INTERVAL_S=2                        # раз во сколько секунд кадр с каждой камеры уходит на анализ
SK_CHECK_INTERVAL_S=60                       # раз во сколько секунд объект сверяется с планом; 0 — не сверять в фоне
SK_ANALYSIS_PROVIDER=auto                    # auto — своя модель, если есть файл, иначе mock; local — только своя модель;
                                             # mock — демо-анализатор; http — внешний сервис; push — сервис сам шлёт детекции
# SK_ANALYSIS_API_URL=http://localhost:8200/analyze
# SK_ANALYSIS_API_KEY=
# SK_INGEST_API_KEY=                         # включает приём готовых детекций: POST /api/ingest/snapshots

# --- своя модель распознавания (YOLO → ONNX; новая версия: python -m tools.export_model best.pt) ---
# SK_DETECTOR_MODEL=models/detector.onnx
# SK_DETECTOR_CONFIDENCE=0.35                 # рамки с уверенностью ниже не показываем и не учитываем
# SK_DETECTOR_ACCELERATE=true                 # CoreML на Mac, CUDA с onnxruntime-gpu; false — только процессор
# SK_DETECTOR_THREADS=0                       # ядер процессора на модель; 0 — решает ONNX Runtime
# SK_DETECTOR_CLASSES={"Truck": "truck", "Pump truck": ""}   # класс модели → тип техники ("" — не показывать)
# SK_REALTIME_FPS=8                           # рамки в реальном времени: кадров видео в секунду с камеры, которую смотрят; 0 — выкл.
# SK_REALTIME_MAX_CAMERAS=8                   # больше камер сразу видео не разбираем

# --- рамки в реальном времени от внешнего сервиса разметки (вместо своей модели) ---
# SK_TRACKER_URL=ws://127.0.0.1:8200/stream   # WebSocket сервиса; задан — рамки от него, своя модель видео не разбирает
# SK_TRACKER_API_KEY=dev-tracker-key          # ключ сервиса: список камер, чтение видео из шлюза (логин sk-tracker),
#                                             # приём кадров /api/ingest (вместе с SK_INGEST_API_KEY или вместо него)
# SK_TRACKER_RTSP_URL=rtsp://192.168.1.10:8554  # адрес шлюза для сервиса на другом компьютере (по умолчанию — SK_VIDEO_RTSP_URL)
# SK_TRACKER_VIDEO_DELAY_MS=150               # на сколько придержать видео, чтобы рамки попадали в технику

# --- работы по камерам: два сервиса аналитики коллеги (контракт frame-analysis-v1, backend/docs) ---
# Имена — из контракта, без SK_ (с SK_ тоже работают). Адреса — базовые, без /v1/analyze/frame; не задан ни один — выкл.
# Настоящие — Docker-комплект коллеги 0.2.0 (docker compose up -d в его каталоге): 127.0.0.1:18001 и 127.0.0.1:18002,
# токен — ANALYTICS_SERVICE_TOKEN из .env комплекта. Имитация обоих: uv run uvicorn app.mock_analytics:app --port 8300
# DETERMINISTIC_SERVICE_URL=http://127.0.0.1:18001          # «по технике»: матрица техники, история, сроки
# VLM_LLM_SERVICE_URL=http://127.0.0.1:18002                # «по снимку»: VLM → LLM (нужен ключ модели в комплекте)
# ANALYTICS_SERVICE_TOKEN=                    # уходит обоим в заголовке Authorization: Bearer …
# ANALYTICS_HTTP_TIMEOUT_SECONDS=1020         # сколько ждать ответ (модельные попытки — до 4 × 240 с)
# SK_ANALYTICS_INTERVAL_MIN=20                # раз во сколько минут отправлять свежий кадр каждой камеры рабочей зоны
# SK_ANALYTICS_HISTORY_DAYS=7                 # окно истории наблюдений в запросе
# SK_ANALYTICS_OBSERVATION_MIN=20             # раз во сколько минут записывать кадр в журнал наблюдений (историю)
# SK_ANALYTICS_CLASSES={"manipulator": "crane_manipulator"}  # тип техники → класс справочника, если не нашёлся сам
# SK_KEEP_USAGE_DAYS=30                       # сколько дней хранить учёт работы техники по часам и ответы аналитики
